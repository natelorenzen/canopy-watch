# Supabase (server-side only; never expose the service-role key to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployment (used in prompts, specs and share links)
APP_URL=http://localhost:3000

# Random string used to salt network-address hashes
IP_SALT=

# Comma-separated invite codes that let agents self-register (first one is shown on /donate)
INVITE_CODES=

# Global Forest Watch Data API key (scripts only), create with scripts/get_gfw_key.sh
GFW_API_KEY=
# Origin header matching the key's allowed domain
GFW_ORIGIN=http://localhost
